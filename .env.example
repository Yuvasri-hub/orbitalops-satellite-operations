# Space Mission Operations & Satellite Management System
# Stack: React + TypeScript + Node.js + Express.js + PostgreSQL + Redis + REST API + Docker

# Server Port
PORT=5000

# PostgreSQL Connection URL
# Local Docker Compose: postgres://postgres:postgres@localhost:5432/space_mission_ops
DATABASE_URL=postgres://postgres:postgres@localhost:5432/space_mission_ops

# Redis In-Memory Cache Connection URL
# Local Docker Compose: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_chars_placeholder
JWT_EXPIRE=7d

# Environment
NODE_ENV=development
AUTO_SEED=true

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Frontend API Base URL (used at build time by Vite)
# Local Dev / Docker: leave empty (defaults to /api)
# Render Cloud: https://your-backend-service.onrender.com
VITE_API_URL=
