# Server Environment Configuration
# Node.js Port (Render dynamically assigns PORT in production, default: 5000)
PORT=5000

# PostgreSQL Connection String
# Local Docker: postgres://postgres:postgres@localhost:5432/space_mission_ops
# Render Managed Postgres: fromDatabase property in Render Blueprint, or postgresql://user:pass@host/db
DATABASE_URL=postgres://postgres:postgres@localhost:5432/space_mission_ops

# Redis / Key Value Cache Connection String
# Local Docker: redis://localhost:6379
# Render Key Value: fromService property in Render Blueprint, or redis://red-xxxx:6379 / rediss://...
REDIS_URL=redis://localhost:6379

# JSON Web Token Secret & Expiration
# In Render Blueprint, JWT_SECRET is automatically generated via generateValue: true
# For local dev, specify a strong random secret:
JWT_SECRET=your_jwt_secret_key_minimum_32_chars_placeholder
JWT_EXPIRE=7d

# CORS Allowed Origin for Frontend Client
# Local Vite Dev: http://localhost:5173
# Local Docker: http://localhost:3000
# Render Production: https://space-ops-frontend.onrender.com (or wildcard * to allow credentials dynamically)
CLIENT_URL=http://localhost:5173

# Application Environment (development | production | test)
NODE_ENV=development

# Automatic Seeding on Startup (true to auto-seed demo constellation and accounts if empty)
AUTO_SEED=true
